# Spring Boot does NOT read .env files by itself. Export these in your shell or set them as
# environment variables in your IDE run configuration. All of them have local defaults.

# --- Database (defaults match the local-db docker compose profile) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USERNAME=app
DB_PASSWORD=app
DB_SSLMODE=prefer

# --- Supabase example ---
# DB_HOST=db.<your-project-ref>.supabase.co     (or the session pooler host)
# DB_PORT=5432                                  (use the direct/session connection, NOT the 6543 transaction pooler)
# DB_NAME=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=<your password>
# DB_SSLMODE=require

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- payment-service ---
# Shared secret used to sign and verify gateway webhooks. Change it outside local development.
WEBHOOK_SECRET=dev-only-secret-change-me
